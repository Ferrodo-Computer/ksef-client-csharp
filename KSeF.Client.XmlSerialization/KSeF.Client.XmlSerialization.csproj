<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageId>KSeF.Client.XmlSerialization</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<IsPackable>true</IsPackable>
		<Authors>Centrum Informatyki Resortu Finansów</Authors>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/CIRFMF/ksef-client-csharp</RepositoryUrl>
		<PackageProjectUrl>https://github.com/CIRFMF/ksef-client-csharp</PackageProjectUrl>
		<PackageDescription>Optional XML serialization support for KSeF client models.</PackageDescription>
		<PackageTags>ksef; e-invoicing; polish; dotnet; integration; invoices; xml</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\KSeF.Client.Core\KSeF.Client.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
